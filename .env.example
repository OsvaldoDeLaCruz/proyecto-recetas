# Copia este archivo como .env y completa los valores. NUNCA subas .env al repositorio.

# --- Aplicación ---
APP_NAME=Recetas IA
# Dominio público que apunta al VPS (lo usa Caddy para el certificado SSL)
DOMAIN=recetas.tudominio.com

# --- JWT ---
# Genera una clave larga: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Límites anti-abuso ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_GENERATE_PER_MINUTE=5
MAX_INGREDIENTS_PER_USER=100

# --- MySQL (usa contraseñas alfanuméricas para no romper la URL de conexión) ---
MYSQL_DATABASE=recetas
MYSQL_USER=recetas_user
MYSQL_PASSWORD=cambia_esta_clave
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root

# Solo para desarrollo local sin Docker (en Docker Compose se construye automáticamente):
# DATABASE_URL=sqlite:///./recetas.db
# DATABASE_URL=mysql+pymysql://recetas_user:clave@localhost:3306/recetas?charset=utf8mb4

# --- LLM (OpenRouter) ---
# Crea tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# auto = la app elige sola el primer modelo GRATUITO disponible en OpenRouter y, si falla,
# prueba el siguiente. También puedes fijar uno o varios en orden: modelo-a:free,modelo-b:free
OPENROUTER_MODEL=auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_MODELS_PER_REQUEST=4
